{
  "baseURL": "https://0.0.0.0",

  "dirs": {
    "origins": "./origins",
    "compared": "./compared"
  },

  "routes": [
    {
      "path": "/about",
      "name": "About page",
      "resolutions": {
        "320x480": [
          {
            "type": "page",
